# Dev frontend: Vite dev server with HMR
# Binds to 0.0.0.0 so the port is reachable from the host and other containers.
# VITE_API_TARGET is set by docker-compose to route /api proxy to the backend container.

# Same ECR Public mirror and digest as the production Dockerfile, so no image
# in this repo depends on Docker Hub's anonymous pull limit.
FROM public.ecr.aws/docker/library/node:22-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392
WORKDIR /app

COPY package*.json tsconfig.admin.json vite.config.ts ./
RUN npm ci

COPY src/admin/ ./src/admin/

EXPOSE 5173

# --host binds to 0.0.0.0 instead of 127.0.0.1
CMD ["npx", "vite", "--config", "vite.config.ts", "--host"]
