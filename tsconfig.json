{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": true
  },
  "include": [
    "src/functions/**/*",
    "src/services/**/*",
    "src/mcp/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/admin"
  ]
}
