[
  {
    "type": "Startup",
    "httpGet": { "path": "/health", "port": 8080, "scheme": "HTTP" },
    "initialDelaySeconds": 10,
    "periodSeconds": 15,
    "timeoutSeconds": 5,
    "failureThreshold": 10
  },
  {
    "type": "Readiness",
    "httpGet": { "path": "/health", "port": 8080, "scheme": "HTTP" },
    "periodSeconds": 10,
    "timeoutSeconds": 5,
    "failureThreshold": 3,
    "successThreshold": 1
  },
  {
    "type": "Liveness",
    "httpGet": { "path": "/health", "port": 8080, "scheme": "HTTP" },
    "periodSeconds": 30,
    "timeoutSeconds": 5,
    "failureThreshold": 3
  }
]
