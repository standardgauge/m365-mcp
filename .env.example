# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real secrets.

# ── Azure AD app registration ─────────────────────────────────────────────────
AZURE_CLIENT_ID=<AAD app registration client ID>
AZURE_CLIENT_SECRET=<AAD app registration client secret>
AZURE_TENANT_ID=<your M365 tenant ID>

# ── Azure Table Storage ───────────────────────────────────────────────────────
# Production: set this to your real Azure Storage account connection string.
# Local dev: leave unset — docker-compose falls back to the Azurite emulator,
# and code outside Docker falls back to UseDevelopmentStorage=true (localhost).
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<name>;AccountKey=<key>;EndpointSuffix=core.windows.net

# ── Default deny lists (per-deployment) ──────────────────────────────────────
# Comma-separated paths that are ALWAYS denied, on top of the admin-managed
# deny-list table. Enforced by folder display name (mail) or path prefix
# (SharePoint), case-insensitively. Leave unset to deny nothing by default.
# A production deployment sets DEFAULT_MAIL_DENY_FOLDERS via infra/main.bicep.
# DEFAULT_MAIL_DENY_FOLDERS=Finance,HR,Legal,IR,Management
# DEFAULT_SHAREPOINT_DENY_PATHS=/sites/Finance,/sites/HR

# ── URLs (rarely change for local dev) ───────────────────────────────────────
OAUTH_REDIRECT_URI=http://localhost:7071/api/auth/callback
FRONTEND_URL=http://localhost:5173
