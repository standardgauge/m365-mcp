{
  "name": "m365-mcp",
  "version": "0.1.0",
  "description": "Microsoft 365 SharePoint + Exchange MCP server via Azure Functions with React admin UI",
  "license": "AGPL-3.0-only",
  "main": "dist/functions/**/*.js",
  "scripts": {
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.json",
    "postbuild": "node -e \"const{cpSync,mkdirSync}=require('fs'),{join}=require('path');mkdirSync(join('dist','install'),{recursive:true});cpSync(join('src','install'),join('dist','install'),{recursive:true});process.stdout.write('templates \\u2192 dist/install\\n')\"",
    "build:admin": "vite build --config vite.config.ts",
    "watch": "tsc -p tsconfig.json --watch",
    "start": "func start",
    "dev": "concurrently \"npm run watch\" \"npm run start\"",
    "dev:admin": "vite --config vite.config.ts",
    "clean": "rimraf dist",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:admin": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@azure/data-tables": "^13.2.0",
    "@azure/functions": "^4.16.5",
    "@azure/monitor-ingestion": "^1.2.0",
    "@azure/msal-node": "^7.0.1",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "applicationinsights": "^3.16.0",
    "isomorphic-fetch": "^3.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.26.7",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "eslint": "^10.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.0.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jsdom": "^30.1.2",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.4.14",
    "typescript": "^7.0.2",
    "vite": "^6.0.5",
    "vitest": "^5.0.4"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true,
          "tsconfig": {
            "module": "ESNext",
            "moduleResolution": "bundler"
          }
        }
      ]
    },
    "testMatch": [
      "**/src/__tests__/**/*.test.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "protobufjs": "^8.4.2",
    "fast-uri": "^3.1.2",
    "fast-xml-builder": "^1.2.0",
    "fast-xml-parser": "^5.8.0",
    "@opentelemetry/propagator-jaeger": "^2.9.0",
    "@opentelemetry/core": "^2.8.0",
    "brace-expansion": "^5.0.8",
    "shell-quote": "^1.11.0",
    "js-yaml@3": {
      "argparse": "^2.0.1"
    }
  }
}
